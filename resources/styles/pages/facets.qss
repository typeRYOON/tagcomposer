/* ── FacetEditorPage ──────────────────────────────────────────────────────── */

#FacetEditorPage {
    background: transparent;
}

#FacetLeftPanel {
    background: #0f0f0f;
    border-right: 1px solid #1a1a1a;
}

#FacetPanelHeader {
    color: #2e2e2e;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 10px 12px 8px 12px;
    border-bottom: 1px solid #1a1a1a;
}

#FacetSearchBar {
    background: #0f0f0f;
    color: #888888;
    border: none;
    border-bottom: 1px solid #1a1a1a;
    padding: 5px 10px;
    font-size: 12px;
    selection-background-color: #2a2a2a;
}

#FacetSearchBar:focus {
    border-bottom-color: #2e2e2e;
    color: #cccccc;
    background: #141414;
}

#FacetCountLabel {
    color: #252525;
    font-size: 11px;
    padding: 4px 12px 4px 12px;
    border-bottom: 1px solid #161616;
}

#FacetTagList {
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
    color: #666666;
}

#FacetTagList::item {
    padding: 4px 12px;
    border: none;
}

#FacetTagList::item:selected {
    background: #1a1a1a;
    color: #cccccc;
}

#FacetTagList::item:hover {
    background: #141414;
    color: #aaaaaa;
}

#FacetEditorHint {
    color: #252525;
    font-size: 13px;
}

#FacetSelectedTag {
    color: #888888;
    font-size: 20px;
    font-weight: bold;
    padding: 4px 0 8px 0;
    border-bottom: 1px solid #1a1a1a;
}

#FacetCheckScroll {
    background: transparent;
    border: none;
}

#FacetCategoryBlock {
    background: transparent;
    border: 1px solid #1e1e1e;
    border-radius: 5px;
}

#FacetCategoryLabel {
    background: transparent;
    color: #2e2e2e;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 0 0 4px 0;
    border-bottom: 1px solid #1a1a1a;
}

#FacetPillBtn {
    background: #181818;
    color: #666666;
    border: 1px solid #262626;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 13px;
}

#FacetPillBtn:hover {
    background: #1f1f1f;
    color: #aaaaaa;
    border-color: #3a3a3a;
}

#FacetPillBtn:checked {
    background: #1a3a1a;
    color: #99cc99;
    border-color: #336633;
}

#FacetPillBtn:checked:hover {
    background: #1f4a1f;
    color: #aaddaa;
    border-color: #3a7a3a;
}

#FacetSaveBtn {
    background: #141414;
    color: #448844;
    border: 1px solid #223322;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}

#FacetSaveBtn:hover {
    background: #192219;
    color: #66aa66;
    border-color: #336633;
}
