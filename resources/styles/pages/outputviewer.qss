/* ── OutputViewerPage ─────────────────────────────────────────────────────── */

#OutputViewerPage {
    background: transparent;
}

/* Section-header bar + label fonts come from app.qss. */
#OvTitle {
    color: #888888;
}

#OvSubtitle {
    color: #555555;
    font-size: 12px;
}

#OvStatus {
    color: #555555;
    font-size: 13px;
    padding: 8px;
}

/* Explicit bg - QSplitter handles are invisible against the dark fill otherwise. */
#OvSplit::handle:horizontal {
    background: #161616;
    border-left:  1px solid #0a0a0a;
    border-right: 1px solid #2a2a2a;
}

#OvSplit::handle:horizontal:hover {
    background: #262626;
}

#OvSplit::handle:horizontal:pressed {
    background: #333333;
}

/* padding-top insets the viewport so the first row clears the header. */
#OutputViewerPage QTreeView {
    background: #0f0f0f;
    color: #aaaaaa;
    border: none;
    outline: 0;
    padding-top: 16px;
    selection-background-color: #1a2a1a;
    selection-color: #cccccc;
}

#OutputViewerPage QTreeView::item {
    padding: 2px 4px;
    border: none;
}

#OutputViewerPage QTreeView::item:hover {
    background: #161616;
    color: #cccccc;
}

#OutputViewerPage QTreeView::item:selected {
    background: #1a2a1a;
    color: #cccccc;
}

#OutputViewerPage QTreeView::branch {
    background: transparent;
}

/* Margins set in code - centerLayout() centres the icon grid. */
#OutputThumbList {
    background: transparent;
    color: #aaaaaa;
    border: none;
    outline: 0;
}

#OutputThumbList::item {
    color: #888888;
    border-radius: 4px;
    padding: 2px;
}

#OutputThumbList::item:hover {
    background: #161616;
    color: #cccccc;
}

#OutputThumbList::item:selected {
    background: #1a2a1a;
    color: #cccccc;
}
