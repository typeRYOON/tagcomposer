/* SettingsPage */

#SettingsPage, #SettingsBody, #SettingsScroll {
    background: transparent;
}

#SettingsSectionHeader {
    color: #303030;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
}

#SettingsGroup {
    background: #0f0f0f;
    border: 1px solid #1a1a1a;
    border-radius: 6px;
}

#SettingsCheckBox {
    color: #888888;
    font-size: 16px;
    spacing: 8px;
}

#SettingsFieldLabel {
    color: #444444;
    font-size: 12px;
}

/* Dark-input base in app.qss. */
#SettingsInput {
    color: #cccccc;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 14px;
}

#SettingsInput:focus {
    border-color: #333333;
    background: #181818;
}

/* Green-action button base in app.qss. */
#SettingsLaunchBtn {
    padding: 5px 12px;
    font-size: 14px;
}

#SettingsConnectBtn {
    background: #141414;
    color: #446688;
    border: 1px solid #223344;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 14px;
}

#SettingsConnectBtn:hover {
    background: #19222e;
    color: #6699cc;
    border-color: #335588;
}

#SettingsSeparator {
    color: #1a1a1a;
}

/* A disc, so the state colors stay in the stylesheet. */
#SettingsStatusDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background: #2a2a2a;
}

#SettingsStatusDot[status="disabled"]     { background: #2a2a2a; }
#SettingsStatusDot[status="connecting"]   { background: #886622; }
#SettingsStatusDot[status="connected"]    { background: #336633; }
#SettingsStatusDot[status="disconnected"] { background: #553333; }
#SettingsStatusDot[status="error"]        { background: #883333; }

#SettingsStatusText {
    color: #444444;
    font-size: 11px;
}

#SettingsHintLabel {
    color: #2a2a2a;
    font-size: 11px;
}

/* Subtle-button base in app.qss. */
#SettingsBrowseBtn {
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}
