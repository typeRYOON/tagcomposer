/* ── WorkflowEditPage ─────────────────────────────────────────────────────── */

#WorkflowEditPage {
    background: transparent;
}

/* Section-header bar (#0f0f0f bg + 1px bottom border) comes from app.qss. */
/* Section-label font (10px bold spaced) for #WfEditTitle also from app.qss. */
#WfEditTitle {
    color: #888888;
}

#WfEditSubtitle {
    color: #555555;
    font-size: 12px;
}

/* Green-action button base in app.qss covers bg/color/border/radius + hover. */
#WfAddBtn {
    padding: 5px 14px;
    font-size: 12px;
}

#WfEditScroll {
    background: transparent;
}

#WfVarCard {
    background: #0f0f0f;
    border: 1px solid #1a1a1a;
    border-radius: 5px;
}

/* Dark-input base in app.qss covers bg/border/selection. */
#WfPlaceholderEdit {
    color: #cccccc;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 12px;
    font-family: monospace;
}

#WfPlaceholderEdit:focus {
    border-color: #333333;
    background: #181818;
}

#WfTypeLabel {
    color: #3a6a3a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 2px 6px;
    background: #0f1a0f;
    border: 1px solid #1a2a1a;
    border-radius: 3px;
}

#WfImageThumb {
    background: #141414;
    border: 1px solid #1a1a1a;
    color: #444444;
    font-size: 11px;
}

#WfRemoveBtn {
    background: transparent;
    border: none;
    color: #3a3a3a;
    font-size: 14px;
    font-weight: bold;
    padding: 0;
}

#WfRemoveBtn:hover {
    color: #cc3333;
}

#WfRadio {
    background: transparent;
    color: #444444;
    font-size: 12px;
    spacing: 5px;
}

#WfRadio::indicator {
    width: 11px;
    height: 11px;
    border-radius: 6px;
    border: 1px solid #2a2a2a;
    background: #141414;
}

#WfRadio::indicator:checked {
    background: #336633;
    border-color: #336633;
}

#WfRadio:checked {
    color: #888888;
}

#WfFieldLabel {
    color: #3a3a3a;
    font-size: 11px;
    min-width: 44px;
}

/* Spinbox base + up/down stub structure come from app.qss. */
#WfSeedSpin, #WfSpinBox {
    padding: 2px 6px;
    font-size: 12px;
}

/* Dark-input base in app.qss covers bg/border/selection. */
#WfValueEdit {
    color: #aaaaaa;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 12px;
}

#WfValueEdit:focus {
    border-color: #333333;
    color: #cccccc;
}

/* Subtle-button base in app.qss covers bg/color/border/radius + hover. */
#WfBrowseBtn {
    padding: 3px 10px;
    font-size: 12px;
}

#WfFileList {
    background: #111111;
    color: #666666;
    border: 1px solid #1e1e1e;
    border-radius: 3px;
    font-size: 12px;
    outline: none;
}

#WfFileList::item {
    padding: 3px 8px;
    border: none;
}

#WfFileList::item:hover {
    background: #1a1a1a;
    color: #aaaaaa;
}

#WfFileList::item:selected {
    background: #141414;
}

/* Empty-state base (font-size) lives in app.qss - only the colour differs. */
#WfEmptyHint {
    color: #252525;
}

#LoraStackImage {
    background: #0a0a0a;
    border: 1px solid #1a1a1a;
    border-radius: 3px;
}
