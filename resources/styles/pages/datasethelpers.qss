/* DatasetHelpersPage */

#DatasetHelpersPage {
    background: transparent;
}

#DatasetTabBtn {
    background: transparent;
    color: #555555;
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 14px;
}

#DatasetTabBtn:hover {
    color: #999999;
}

/* Highlight pill is drawn by the animated #DatasetTabIndicator below. */
#DatasetTabBtn:checked {
    background: transparent;
    color: #dddddd;
}

#DatasetTabIndicator {
    background: #1e1e1e;
    border-radius: 5px;
}

/* Panel owns the right edge for both sections so the seam is single-lined. */
#DatasetParamsPanel {
    background: #111111;
    border-right: 1px solid #2a2a2a;
}

/* No border-bottom - the filter body's border-top owns the seam. */
#DatasetFilterSectionHeader {
    background: #0f0f0f;
}

/* Section-label font in app.qss. */
#DatasetSectionTitle {
    color: #888888;
}

#DatasetSectionSubtitle {
    color: #777777;
    font-size: 13px;
}

#DatasetSectionBody {
    background: transparent;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
}

/* Background must be explicit - Qt skips the border paint on transparent widgets. */
#DatasetFilterBody {
    background: #111111;
    border-top: 1px solid #2a2a2a;
    border-right: 1px solid #2a2a2a;
}

/* Empty-state base in app.qss. */
#DatasetEmptyState {
    color: #555555;
}

#DatasetParamLabel {
    color: #777777;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
}

#DatasetSpin {
    background: #161616;
    color: #cccccc;
    border: 1px solid #222222;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 14px;
}

/* Dropdown needs explicit styling - Qt's platform default is unreadable on Windows. */
QComboBox#DatasetSpin::drop-down {
    border: none;
    width: 18px;
}

QComboBox#DatasetSpin QAbstractItemView {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: 0;
}

#DatasetBrowseBtn {
    background: #1a1a1a;
    color: #aaaaaa;
    border: 1px solid #262626;
    border-radius: 5px;
    padding: 0;
    text-align: center;
    font-size: 14px;
}

#DatasetBrowseBtn:hover {
    background: #222222;
    color: #dddddd;
    border-color: #333333;
}

#DatasetBrowseBtn:disabled {
    background: #141414;
    color: #3a3a3a;
    border-color: #1e1e1e;
}

#DatasetRunBtn {
    background: #181e18;
    color: #5a9a5a;
    border: 1px solid #2a4a2a;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 14px;
}

#DatasetRunBtn:hover {
    background: #1e2e1e;
    color: #7acc7a;
    border-color: #3a6a3a;
}

#DatasetRunBtn:disabled {
    background: #141414;
    color: #2a2a2a;
    border-color: #1a1a1a;
}

/* Secondary button beside #DatasetRunBtn: same box metrics, neutral palette. */
#DatasetCancelBtn {
    background: #1a1a1a;
    color: #999999;
    border: 1px solid #2a2a2a;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 14px;
}

#DatasetCancelBtn:hover {
    background: #222222;
    color: #cccccc;
    border-color: #383838;
}

#DatasetCancelBtn:disabled {
    background: #141414;
    color: #2a2a2a;
    border-color: #1a1a1a;
}

/* Dark-input base in app.qss. */
#DatasetExcludeEdit {
    color: #cccccc;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 15px;
}

#DatasetStatusLabel {
    color: #777777;
    font-size: 14px;
}

/* Run-state disc beside DatasetStatusLabel. */
#CollectorActiveDot {
    min-width: 7px;
    max-width: 7px;
    min-height: 7px;
    max-height: 7px;
    border-radius: 3px;
    background: #777777;
}

#DatasetProgressBar {
    background: #161616;
    border: 1px solid #222222;
    border-radius: 3px;
    color: #888888;
    font-size: 13px;
    text-align: center;
}

#DatasetProgressBar::chunk {
    background: #2a4a2a;
    border-radius: 2px;
}

#DatasetResultsList {
    background: transparent;
}

#DatasetResultsScroll {
    background: transparent;
}

#DatasetResultRow {
    background: transparent;
    border-radius: 3px;
}

#DatasetResultRow:hover {
    background: #161616;
}

#DatasetResultTag {
    color: #dddddd;
    font-size: 14px;
}

#DatasetResultScore {
    color: #aaaaaa;
    font-size: 14px;
}

/* Dark-input base in app.qss. */
#DatasetCopyEdit {
    color: #aaaaaa;
    border-radius: 3px;
    font-size: 14px;
}

#DatasetPreviewPanel {
    background: #111111;
    border-left: 1px solid #1e1e1e;
}

#DatasetPreviewImage {
    background: transparent;
    border-radius: 6px;
}

#DatasetParamValue {
    color: #aaaaaa;
    font-size: 14px;
}

#DatasetSoloCheck {
    color: #aaaaaa;
    font-size: 14px;
    spacing: 6px;
}

/* Indicator base from app.qss; greyer green than the standard. */
#DatasetSoloCheck::indicator:checked {
    background: #2a4a2a;
    border-color: #3a6a3a;
}

#DatasetFilterMode {
    color: #cccccc;
    font-size: 14px;
    spacing: 6px;
}

#DatasetFilterMode::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #2a2a2a;
    border-radius: 7px;
    background: #141414;
}

#DatasetFilterMode::indicator:checked {
    background: #5a8a5a;
    border-color: #6a9a6a;
}

#DatasetPmiSlider::groove:horizontal {
    background: #161616;
    height: 4px;
    border-radius: 2px;
}

#DatasetPmiSlider::handle:horizontal {
    background: #555555;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#DatasetPmiSlider::handle:horizontal:hover {
    background: #888888;
}

#DatasetPmiSlider::sub-page:horizontal {
    background: #2a4a2a;
    border-radius: 2px;
}
