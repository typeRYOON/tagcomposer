/* ── DatasetHelpersPage ───────────────────────────────────────────────────── */

#DatasetHelpersPage {
    background: transparent;
}

/* Section-header bar (#0f0f0f bg + 1px bottom border) comes from app.qss. */

#DatasetTabBtn {
    background: transparent;
    color: #555555;
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 14px;
}

#DatasetTabBtn:hover {
    color: #999999;
}

/* Active button stays transparent - the animated #DatasetTabIndicator below
   the buttons draws the highlight pill, which slides between tabs. */
#DatasetTabBtn:checked {
    background: transparent;
    color: #dddddd;
}

#DatasetTabIndicator {
    background: #1e1e1e;
    border-radius: 5px;
}

/* The panel owns the single right edge for both the TAG section and the
   FACET FILTER section - keeping it on the panel (instead of on each body
   widget) avoids the doubled-line look at the boundary between them. */
#DatasetParamsPanel {
    background: #111111;
    border-right: 1px solid #2a2a2a;
}

/* Section-header bar (#0f0f0f bg + 1px bottom border) comes from app.qss. */

/* Filter section header skips the border-bottom so the filter body's
   border-top is the only horizontal line at the seam. */
#DatasetFilterSectionHeader {
    background: #0f0f0f;
}

/* Section-label font (10px bold spaced) comes from app.qss. */
#DatasetSectionTitle {
    color: #888888;
}

/* Subtitle that sits next to a section title - used for things like the
   currently focused image's filename in the IMAGE header. Dimmer than the
   title so the eye lands on the title first. */
#DatasetSectionSubtitle {
    color: #777777;
    font-size: 13px;
}

#DatasetSectionBody {
    background: transparent;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
}

/* Top border draws the seam between the FACET FILTER header and its body
   (the header skips its own border-bottom so this line stands alone). The
   right edge is owned by #DatasetParamsPanel so we don't paint it here.
   Background is set explicitly so the QSS border actually paints - Qt's
   stylesheet engine skips the box-model paint pass on transparent widgets. */
#DatasetFilterBody {
    background: #111111;
    border-top: 1px solid #2a2a2a;
    border-right: 1px solid #2a2a2a;
}

/* Empty-state base (font-size) lives in app.qss - only the colour differs. */
#DatasetEmptyState {
    color: #555555;
}

#DatasetParamLabel {
    color: #777777;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

#DatasetSpin {
    background: #161616;
    color: #cccccc;
    border: 1px solid #222222;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 14px;
}

/* QComboBox sharing the #DatasetSpin objectName needs its dropdown view
   styled separately - without these rules, Qt falls back to the platform
   default (white-on-white on Windows) which is unreadable. Mirrors the
   QDialog QComboBox treatment in app.qss. */
QComboBox#DatasetSpin::drop-down {
    border: none;
    width: 18px;
}

QComboBox#DatasetSpin QAbstractItemView {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: 0;
}

/* Square ellipsis buttons next to folder pickers. Text-align center so the
   "…" sits in the middle - #EntryActionBtn (the obvious other candidate)
   has text-align: left because it's used for left-anchored action rows. */
#DatasetBrowseBtn {
    background: #1a1a1a;
    color: #aaaaaa;
    border: 1px solid #262626;
    border-radius: 5px;
    padding: 0;
    text-align: center;
    font-size: 14px;
}

#DatasetBrowseBtn:hover {
    background: #222222;
    color: #dddddd;
    border-color: #333333;
}

#DatasetBrowseBtn:disabled {
    background: #141414;
    color: #3a3a3a;
    border-color: #1e1e1e;
}

#DatasetRunBtn {
    background: #181e18;
    color: #5a9a5a;
    border: 1px solid #2a4a2a;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 14px;
}

#DatasetRunBtn:hover {
    background: #1e2e1e;
    color: #7acc7a;
    border-color: #3a6a3a;
}

#DatasetRunBtn:disabled {
    background: #141414;
    color: #2a2a2a;
    border-color: #1a1a1a;
}

/* Dark-input base in app.qss covers bg/border/selection. */
#DatasetExcludeEdit {
    color: #cccccc;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 15px;
}

#DatasetStatusLabel {
    color: #777777;
    font-size: 14px;
}

#DatasetProgressBar {
    background: #161616;
    border: 1px solid #222222;
    border-radius: 3px;
    color: #888888;
    font-size: 13px;
    text-align: center;
}

#DatasetProgressBar::chunk {
    background: #2a4a2a;
    border-radius: 2px;
}

#DatasetResultsList {
    background: transparent;
}

#DatasetResultsScroll {
    background: transparent;
}

/* Transparent rows - only the hover state paints a background. */
#DatasetResultRow {
    background: transparent;
    border-radius: 3px;
}

#DatasetResultRow:hover {
    background: #161616;
}

#DatasetResultTag {
    color: #dddddd;
    font-size: 14px;
}

#DatasetResultScore {
    color: #aaaaaa;
    font-size: 14px;
}

/* Dark-input base in app.qss covers bg/border/selection. */
#DatasetCopyEdit {
    color: #aaaaaa;
    border-radius: 3px;
    font-size: 14px;
}

/* Right-pane wiki/post preview. */
#DatasetPreviewPanel {
    background: #111111;
    border-left: 1px solid #1e1e1e;
}

#DatasetPreviewImage {
    background: transparent;
    border-radius: 6px;
}

/* Reading the live PMI threshold off the slider. */
#DatasetParamValue {
    color: #aaaaaa;
    font-size: 14px;
}

#DatasetSoloCheck {
    color: #aaaaaa;
    font-size: 14px;
    spacing: 6px;
}

/* Indicator base from app.qss; only the :checked accent differs (slightly
   greyer green than the standard #336633). */
#DatasetSoloCheck::indicator:checked {
    background: #2a4a2a;
    border-color: #3a6a3a;
}

/* Whitelist / blacklist mode radios for the facet-rule editor. */
#DatasetFilterMode {
    color: #cccccc;
    font-size: 14px;
    spacing: 6px;
}

#DatasetFilterMode::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #2a2a2a;
    border-radius: 7px;
    background: #141414;
}

#DatasetFilterMode::indicator:checked {
    background: #5a8a5a;
    border-color: #6a9a6a;
}

/* Slim slider for the live PMI threshold. */
#DatasetPmiSlider::groove:horizontal {
    background: #161616;
    height: 4px;
    border-radius: 2px;
}

#DatasetPmiSlider::handle:horizontal {
    background: #555555;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#DatasetPmiSlider::handle:horizontal:hover {
    background: #888888;
}

#DatasetPmiSlider::sub-page:horizontal {
    background: #2a4a2a;
    border-radius: 2px;
}
