/* ── TagSearchBar ─────────────────────────────────────────────────────────── */

/* #TagSearchInput base in app.qss. */
#TagSearchInput:focus {
    border-color: #444444;
}

#TagSearchInput:disabled {
    background: #141414;
    color: #2a2a2a;
    border-color: #1e1e1e;
}

#TagSearchPopup {
    background: #161616;
    border: 1px solid #2e2e2e;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

#TagSearchList {
    background: transparent;
    border: none;
    outline: none;
}

#TagSearchList::item {
    border: none;
    padding: 0px;
}
