/* Entry nav panel (top-right float on EntryView) */

#EntryNavPanel {
    background: #0e0e0e;
    border: 1px solid #1e1e1e;
    border-radius: 4px;
}

#EntryNavHandle {
    color: #555555;
    font-size: 12px;
    background: transparent;
    padding: 0 8px;
}

#EntryNavList {
    background: transparent;
}

#EntryNavBtn {
    background: transparent;
    color: #666666;
    border: none;
    border-radius: 0;
    font-size: 11px;
    padding: 2px 10px;
    text-align: left;
}

#EntryNavBtn:hover {
    background: #1a1a1a;
    color: #aaaaaa;
}
