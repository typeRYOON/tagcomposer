/* ── App-wide ─────────────────────────────────────────────────────────────── */

/* Palette — the de-facto theme tokens used across every QSS file. Qt has no
   native variables, so these are kept here as a search/replace cheat sheet
   and a hint that these colours are load-bearing. Treat any new use of an
   off-palette colour as a smell unless it's an accent (red/green/amber/blue)
   tied to a specific status.

       Surfaces:   #0d0d0d  page bg          #0f0f0f  panel bg
                   #111111  raised panel     #141414  input bg
                   #181818  input focus bg   #1a1a1a  hover bg
                   #1e1e1e  spin button bg
       Borders:    #1a1a1a  faint            #1e1e1e  subtle
                   #222222  default          #2a2a2a  emphatic
                   #333333  focus            #3a3a3a  hover focus
       Text:       #cccccc  primary          #aaaaaa  secondary
                   #888888  muted            #555555  hint
                   #3a3a3a  placeholder      #2a2a2a  disabled
       Selection:  #2a2a2a  text bg          #ffffff  text fg
       Accents:    #336633 / #66aa66 / #5a9a5a  green (action / success)
                   #cc6666 / #cc3333            red (destructive)
                   #886622 / #c8a050            amber (flagged / weighted)
                   #5588bb / #77aadd            blue (run / info)
*/

QMainWindow, QWidget {
    background: transparent;
    color: #e0e0e0;
    font-family: "Hiragino Maru Gothic ProN W4";
    font-size: 16px;
}

#MainPages {
    background: #0d0d0d;
}

/* ── Dialogs ──────────────────────────────────────────────────────────────── */
/* Scoped to QDialog so existing widget-specific styles (#SettingsInput, the
   tag search bar, etc.) keep their look — but dialogs get readable defaults. */

QDialog {
    background: #0d0d0d;
    color: #e0e0e0;
}

QDialog QLabel {
    color: #e0e0e0;
    background: transparent;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QAbstractSpinBox {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus,
QDialog QAbstractSpinBox:focus {
    border-color: #3a3a3a;
    background: #181818;
}

QDialog QLineEdit:read-only {
    color: #aaaaaa;
    background: #101010;
}

QDialog QComboBox::drop-down {
    border: none;
    width: 18px;
}

QDialog QComboBox QAbstractItemView {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: 0;
}

QDialog QPushButton {
    background: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 5px 14px;
}

QDialog QPushButton:hover {
    background: #232323;
    border-color: #3a3a3a;
}

QDialog QPushButton:pressed {
    background: #141414;
}

QDialog QPushButton:disabled {
    color: #555555;
    border-color: #1a1a1a;
}

QDialog QPushButton:checked {
    background: #2a1a1a;
    border-color: #553333;
    color: #cc6666;
}

QDialog QRadioButton,
QDialog QCheckBox {
    color: #e0e0e0;
    spacing: 6px;
    background: transparent;
}

QDialog QRadioButton::indicator,
QDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #333333;
    background: #141414;
}

QDialog QRadioButton::indicator {
    border-radius: 8px;
}

QDialog QCheckBox::indicator {
    border-radius: 3px;
}

QDialog QRadioButton::indicator:checked,
QDialog QCheckBox::indicator:checked {
    background: #4a7a4a;
    border-color: #5a8a5a;
}

/* ── Shared widget patterns ───────────────────────────────────────────────── */
/* Bases for widget patterns that recur across pages. Each pattern is keyed
   by objectName, not by class, so per-page rules below this file (loaded
   later in alphabetical order) can still override individual declarations. */

/* Dark input — line edits and similar text fields with a #141414 fill and a
   subtle border. Per-page rules customise color/padding/font-size/radius and
   keep their own :focus declaration since each diverges (some shift bg, some
   shift only color, #EntryComment uses a darker base border). */
#SettingsInput,
#WfValueEdit,
#WfPlaceholderEdit,
#DatasetExcludeEdit,
#DatasetCopyEdit {
    background: #141414;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
}

/* Green action button — primary/affirmative actions (Save, Run, Add, Launch).
   Per-page rules adjust padding/font-size only. */
#SettingsLaunchBtn,
#FacetSaveBtn,
#WfAddBtn {
    background: #141414;
    color: #448844;
    border: 1px solid #223322;
    border-radius: 4px;
}

#SettingsLaunchBtn:hover,
#FacetSaveBtn:hover,
#WfAddBtn:hover {
    background: #192219;
    color: #66aa66;
    border-color: #336633;
}

/* Subtle secondary button — Browse, Copy, action-row buttons. Per-page
   rules differ only in padding, font-size, and text-align. */
#SettingsBrowseBtn,
#WfBrowseBtn,
#ComposerCopyBtn {
    background: #141414;
    color: #555555;
    border: 1px solid #222222;
    border-radius: 3px;
}

#SettingsBrowseBtn:hover,
#WfBrowseBtn:hover,
#ComposerCopyBtn:hover {
    background: #1a1a1a;
    color: #999999;
    border-color: #333333;
}

/* Spinbox container — dark fill with a slim up/down stub stack on the right.
   #LoraSpinBox is intentionally excluded: it diverges enough (different color,
   border, padding, stub width) that an override-per-property would cost more
   than it saves. */
#ComposerCountSpin,
#WfSeedSpin,
#WfSpinBox {
    background: #141414;
    color: #aaaaaa;
    border: 1px solid #222222;
    border-radius: 3px;
    selection-background-color: #2a2a2a;
}

#ComposerCountSpin:focus,
#WfSeedSpin:focus,
#WfSpinBox:focus {
    border-color: #333333;
}

#ComposerCountSpin::up-button,
#WfSeedSpin::up-button,
#WfSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 14px;
    background: #1e1e1e;
    border: none;
    border-left: 1px solid #222222;
    border-bottom: 1px solid #222222;
}

#ComposerCountSpin::down-button,
#WfSeedSpin::down-button,
#WfSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 14px;
    background: #1e1e1e;
    border: none;
    border-left: 1px solid #222222;
}

#ComposerCountSpin::up-button:hover,   #ComposerCountSpin::down-button:hover,
#WfSeedSpin::up-button:hover,          #WfSeedSpin::down-button:hover,
#WfSpinBox::up-button:hover,           #WfSpinBox::down-button:hover {
    background: #282828;
}

/* Green-checked square checkbox indicator — the tri-color status checkbox
   pattern. Per-page rules can override checked colors when the accent
   shifts (e.g. #DatasetSoloCheck uses a slightly different green). */
#SettingsCheckBox::indicator,
#ComposerRuleToggle::indicator,
#DatasetSoloCheck::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    background: #141414;
}

#SettingsCheckBox::indicator:checked,
#ComposerRuleToggle::indicator:checked {
    background: #336633;
    border-color: #336633;
}

/* Section header label — small bold uppercase letterspaced caption. The
   #ComposerGroupHeader on the composer page is intentionally larger and
   keeps its own rule. */
#ComposerHeaderLabel,
#FacetPanelHeader,
#WfEditTitle,
#OvTitle,
#DatasetSectionTitle,
#WfSidebarHeaderLabel,
#EntrySubLabel {
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Section header bar — the dark strip above each panel body, with a 1px
   separator at its bottom. */
#WfEditHeader,
#OvHeader,
#DatasetTabBar,
#DatasetSectionHeader,
#WikiHeader {
    background: #0f0f0f;
    border-bottom: 1px solid #1a1a1a;
}

/* Tile-view / composer top-level search field. Same shape, two object names
   because they live in different widgets and the C++ code looks them up by
   name. */
#SearchBar,
#TagSearchInput {
    background: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    padding: 6px 10px;
    font-size: 16px;
    selection-background-color: #3a3a3a;
}

/* Inline validation message rendered next to a form field (import dialog,
   entry-create panel). Keep this rule scoped to QLabel so the colour
   doesn't bleed into descendants. */
QLabel#ValidationLabel {
    color: #cc6666;
}
