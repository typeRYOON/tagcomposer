/* App-wide */

/* Palette tokens (Qt has no native variables - search/replace cheat sheet):
       Surfaces:   #0d0d0d  page bg          #0f0f0f  panel bg
                   #111111  raised panel     #141414  input bg
                   #181818  input focus bg   #1a1a1a  hover bg
                   #1e1e1e  spin button bg
       Borders:    #1a1a1a  faint            #1e1e1e  subtle
                   #222222  default          #2a2a2a  emphatic
                   #333333  focus            #3a3a3a  hover focus
       Text:       #cccccc  primary          #aaaaaa  secondary
                   #888888  muted            #555555  hint
                   #3a3a3a  placeholder      #2a2a2a  disabled
       Selection:  #2a2a2a  text bg          #ffffff  text fg
       Accents:    green #336633/#66aa66/#5a9a5a   red #cc6666/#cc3333
                   amber #886622/#c8a050           blue #5588bb/#77aadd
*/

QMainWindow, QWidget {
    background: transparent;
    color: #e0e0e0;
    font-family: "Hiragino Maru Gothic ProN W4";
    font-size: 16px;
}

#MainPages {
    background: #0d0d0d;
}

/* Dialogs */

QDialog {
    background: #0d0d0d;
    color: #e0e0e0;
}

QDialog QLabel {
    color: #e0e0e0;
    background: transparent;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QAbstractSpinBox {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus,
QDialog QAbstractSpinBox:focus {
    border-color: #3a3a3a;
    background: #181818;
}

QDialog QLineEdit:read-only {
    color: #aaaaaa;
    background: #101010;
}

QDialog QComboBox::drop-down {
    border: none;
    width: 18px;
}

QDialog QComboBox QAbstractItemView {
    background: #141414;
    color: #e0e0e0;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: 0;
}

QDialog QPushButton {
    background: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 5px 14px;
}

QDialog QPushButton:hover {
    background: #232323;
    border-color: #3a3a3a;
}

QDialog QPushButton:pressed {
    background: #141414;
}

#TitleBarMin, #TitleBarMax, #TitleBarClose {
    background: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
}

#TitleBarMin:hover, #TitleBarMax:hover, #TitleBarClose:hover {
    background: #232323;
    border-color: #3a3a3a;
}

#TitleBarMin:pressed, #TitleBarMax:pressed, #TitleBarClose:pressed {
    background: #141414;
}

QDialog QPushButton:disabled {
    color: #555555;
    border-color: #1a1a1a;
}

QDialog QPushButton:checked {
    background: #2a1a1a;
    border-color: #553333;
    color: #cc6666;
}

QDialog QRadioButton,
QDialog QCheckBox {
    color: #e0e0e0;
    spacing: 6px;
    background: transparent;
}

QDialog QRadioButton::indicator,
QDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #333333;
    background: #141414;
}

QDialog QRadioButton::indicator {
    border-radius: 8px;
}

QDialog QCheckBox::indicator {
    border-radius: 3px;
}

QDialog QRadioButton::indicator:checked,
QDialog QCheckBox::indicator:checked {
    background: #4a7a4a;
    border-color: #5a8a5a;
}

/* Context menus */
/* ::item:selected covers both mouse hover and keyboard navigation. */

QMenu {
    background: #0f0f0f;
    color: #cccccc;
    border: 1px solid #222222;
    padding: 4px 0;
}

QMenu::item {
    background: transparent;
    padding: 6px 18px;
}

QMenu::item:selected {
    background: #1a1a1a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #555555;
}

QMenu::separator {
    height: 1px;
    background: #1a1a1a;
    margin: 4px 8px;
}

/* Shared widget patterns */
/* Keyed by objectName so per-page rules (loaded later) can override. */

/* Dark input base - per-page rules add :focus and tweak padding/font. */
#SettingsInput,
#WfValueEdit,
#WfPlaceholderEdit,
#DatasetExcludeEdit,
#DatasetCopyEdit {
    background: #141414;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
}

/* Green action button base (Save, Run, Add, Launch). */
#SettingsLaunchBtn,
#FacetSaveBtn,
#WfAddBtn {
    background: #141414;
    color: #448844;
    border: 1px solid #223322;
    border-radius: 4px;
}

#SettingsLaunchBtn:hover,
#FacetSaveBtn:hover,
#WfAddBtn:hover {
    background: #192219;
    color: #66aa66;
    border-color: #336633;
}

/* Subtle secondary button base (Browse, Copy, action rows). */
#SettingsBrowseBtn,
#WfBrowseBtn,
#ComposerCopyBtn {
    background: #141414;
    color: #555555;
    border: 1px solid #222222;
    border-radius: 3px;
}

#SettingsBrowseBtn:hover,
#WfBrowseBtn:hover,
#ComposerCopyBtn:hover {
    background: #1a1a1a;
    color: #999999;
    border-color: #333333;
}

/* Spinbox base. #LoraSpinBox is intentionally excluded - it diverges too far. */
#ComposerCountSpin,
#WfSeedSpin,
#WfSpinBox {
    background: #141414;
    color: #aaaaaa;
    border: 1px solid #222222;
    border-radius: 3px;
    selection-background-color: #2a2a2a;
}

#ComposerCountSpin:focus,
#WfSeedSpin:focus,
#WfSpinBox:focus {
    border-color: #333333;
}

#ComposerCountSpin::up-button,
#WfSeedSpin::up-button,
#WfSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 14px;
    background: #1e1e1e;
    border: none;
    border-left: 1px solid #222222;
    border-bottom: 1px solid #222222;
}

#ComposerCountSpin::down-button,
#WfSeedSpin::down-button,
#WfSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 14px;
    background: #1e1e1e;
    border: none;
    border-left: 1px solid #222222;
}

#ComposerCountSpin::up-button:hover,   #ComposerCountSpin::down-button:hover,
#WfSeedSpin::up-button:hover,          #WfSeedSpin::down-button:hover,
#WfSpinBox::up-button:hover,           #WfSpinBox::down-button:hover {
    background: #282828;
}

/* Green-checked square checkbox indicator base. */
#SettingsCheckBox::indicator,
#ComposerRuleToggle::indicator,
#DatasetSoloCheck::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    background: #141414;
}

#SettingsCheckBox::indicator:checked,
#ComposerRuleToggle::indicator:checked {
    background: #336633;
    border-color: #336633;
}

/* Section header label base (small bold spaced caption). */
#ComposerHeaderLabel,
#FacetPanelHeader,
#WfEditTitle,
#OvTitle,
#DatasetSectionTitle,
#WfSidebarHeaderLabel,
#EntrySubLabel {
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Empty-state placeholder base - per-page rules set the color. */
#DatasetEmptyState,
#EntryEmptyLabel,
#WfEmptyHint,
#FacetEditorHint,
#ComposerEmptyHint,
#ComposerRulesHint {
    font-size: 15px;
}

/* Section header bar base. */
#WfEditHeader,
#OvHeader,
#DatasetTabBar,
#DatasetSectionHeader,
#WikiHeader {
    background: #0f0f0f;
    border-bottom: 1px solid #1a1a1a;
}

/* Top-level search field base (two object names, same shape). */
#SearchBar,
#TagSearchInput {
    background: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    padding: 6px 10px;
    font-size: 16px;
    selection-background-color: #3a3a3a;
}

/* QLabel-scoped so the color doesn't bleed into descendants. */
QLabel#ValidationLabel {
    color: #cc6666;
}
