/* ── PromptComposerPage ───────────────────────────────────────────────────── */

#PromptComposerPage {
    background: transparent;
}

#ComposerHairlineSep {
    background: #1a1a1a;
}

#ComposerScroll, #ComposerGroupsContainer {
    background: transparent;
}

/* Empty-state base in app.qss. */
#ComposerEmptyHint {
    color: #2e2e2e;
}

#ComposerGroupHeader {
    color: #383838;
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 10px 12px 2px 12px;
}

#ComposerTagRow {
    background: transparent;
    border-radius: 3px;
}

#ComposerTagRow:hover {
    background: #141414;
}

#ComposerTagRow[selected="true"] {
    background: #1c2837;
}

#ComposerTagEdit {
    background: transparent;
    border: none;
    color: #cccccc;
    font-size: 20px;
    padding: 0;
    selection-background-color: #2a2a2a;
}

#ComposerTagEdit:focus {
    background: #161616;
    border-bottom: 1px solid #333333;
    color: #e0e0e0;
}

#ComposerTagReadOnly {
    background: transparent;
    border: none;
    color: #383838;
    font-size: 20px;
    padding: 0;
}

#ComposerTagVar {
    background: transparent;
    border: none;
    color: #cccccc;
    font-size: 20px;
    padding: 0;
}

#ComposerTagInjected {
    background: transparent;
    border: none;
    color: #a8eda8;
    font-size: 20px;
    padding: 0;
}


#ComposerVarBadge {
    background: transparent;
    color: #664422;
    font-size: 16px;
}

#ComposerNoBadge {
    background: transparent;
    color: #334466;
    font-size: 16px;
    font-weight: bold;
}

#ComposerUndefToggle {
    background: #141414;
    color: #555555;
    border: 1px solid #1e1e1e;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: bold;
    min-width: 18px;
}

#ComposerUndoBtn, #ComposerRedoBtn {
    background: #141414;
    color: #777777;
    border: 1px solid #1e1e1e;
    border-radius: 3px;
    font-size: 14px;
    padding: 0;
}

#ComposerUndoBtn:hover, #ComposerRedoBtn:hover {
    background: #1a1a1a;
    color: #cccccc;
}

#ComposerUndoBtn:disabled, #ComposerRedoBtn:disabled {
    color: #2a2a2a;
    background: #0f0f0f;
    border-color: #1a1a1a;
}

#ComposerUndefToggle[warn="true"] {
    color: #6688aa;
}

#ComposerUndefToggle:hover {
    background: #1a1a1a;
    color: #999999;
}

#ComposerUndefToggle[warn="true"]:hover {
    color: #aaccee;
}

#ComposerUndefToggle:checked {
    background: #334466;
    color: #ffffff;
    border-color: #4477aa;
}

#ComposerUndefToggle:disabled {
    color: #2a2a2a;
    background: #0f0f0f;
    border-color: #1a1a1a;
}

#ComposerFlagBadge {
    background: transparent;
    color: #886622;
    font-size: 16px;
}

#ComposerInjectedBadge {
    background: transparent;
    color: #336633;
    font-size: 16px;
}

#ComposerSidebar {
    background: #0f0f0f;
    border-left: 1px solid #1a1a1a;
}

#ComposerRulesScroll, #ComposerRulesContainer {
    background: transparent;
    border-left: 1px solid #1a1a1a;
}

#ComposerVarsScroll, #ComposerVarsContainer {
    background: transparent;
    border-left: 1px solid #1a1a1a;
}

#ComposerProfilesBody {
    background: transparent;
    border-left: 1px solid #1a1a1a;
}

#ComposerProfileLabel {
    color: #666666;
    font-size: 12px;
}

#ComposerProfileBox {
    background: #141414;
    color: #8899aa;
    border: 1px solid #1e1e1e;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 14px;
}

#ComposerProfileBox:hover {
    border-color: #2a2a2a;
}

#ComposerProfileBox:focus {
    border-color: #333333;
    color: #aabbcc;
}

/* Dropdown needs explicit styling - the platform default is unreadable here. */
QComboBox#ComposerProfileBox::drop-down {
    border: none;
    width: 16px;
}

QComboBox#ComposerProfileBox QAbstractItemView {
    background: #141414;
    color: #cccccc;
    border: 1px solid #222222;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    outline: 0;
}

#ComposerHeaderRow {
    border-bottom: 1px solid #1a1a1a;
}


/* Section-label font in app.qss. */
#ComposerHeaderLabel {
    color: #888888;
}

#SidebarBtn {
    background: transparent;
    color: #3a3a3a;
    border: none;
    font-size: 14px;
    padding: 0;
}

#SidebarBtn:hover {
    color: #777777;
    background: #1a1a1a;
    border-radius: 3px;
}

#ComposerRuleToggle {
    background: transparent;
    color: #555555;
    font-size: 14px;
    spacing: 6px;
    border: none;
    padding: 3px 0;
}

#ComposerRuleToggle:checked {
    color: #909090;
}

/* Smaller/squarer than the shared indicator base. */
#ComposerRuleToggle::indicator {
    width: 12px;
    height: 12px;
    border-radius: 2px;
}

#ComposerRuleName {
    color: #555555;
    font-size: 14px;
    background: transparent;
    padding: 3px 0;
}

#ComposerRuleToggle:checked + #ComposerRuleName,
#ComposerRuleName[active="true"] {
    color: #909090;
}

#ComposerRuleArgDelBtn {
    background: transparent;
    color: #444444;
    border: none;
    font-size: 12px;
    padding: 0;
}

#ComposerRuleArgDelBtn:hover {
    color: #aa6666;
}

/* These three carry a painted icon rather than a glyph, so their color is set
   where the icon is built (promptcomposerpage_sidebars.cpp), not here. */
#ComposerRuleAddBadge,
#ComposerRuleReplaceBadge,
#ComposerRuleForceBadge {
    background: transparent;
}

/* Empty-state base in app.qss. */
#ComposerRulesHint {
    color: #282828;
    padding: 8px;
}

#ComposerRuleArgEdit {
    background: #141414;
    color: #557766;
    border: 1px solid #1a1a1a;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 14px;
    selection-background-color: #2a2a2a;
}

#ComposerRuleArgEdit:focus {
    border-color: #2e2e2e;
    color: #77aa88;
}

#ComposerWeightSpin {
    background: transparent;
    color: #2a2a2a;
    border: none;
    font-size: 11px;
    padding: 0 2px;
    selection-background-color: #2a2a2a;
}

#ComposerWeightSpin:focus {
    color: #886644;
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 2px;
}

#ComposerTagRow:hover #ComposerWeightSpin {
    color: #404040;
}

#ComposerWeightSpin[weighted="true"] {
    color: #c8a050;
}

#ComposerTagRow:hover #ComposerWeightSpin[weighted="true"] {
    color: #d4b060;
}

#TagRemoveBtn {
    background: transparent;
    border: none;
    color: #3a3a3a;
    font-size: 14px;
    font-weight: bold;
    padding: 0;
    text-align: center;
}

#TagRemoveBtn:hover {
    color: #cc3333;
}
