/* ── Clear button (top-right float, left of nav panel) ────────────── */

#ComposerClearBtn {
    background: #0e0e0e;
    color: #555555;
    border: 1px solid #1e1e1e;
    border-radius: 4px;
    font-size: 12px;
    padding: 0 10px;
}

#ComposerClearBtn:hover {
    background: #1a1a1a;
    color: #cc5555;
    border-color: #3a2020;
}

/* Pushed-entries filter toggle, left of Clear. Same chrome as Clear; the
   checked state matches the composer's other filter toggle. */

#ComposerPushedBtn {
    background: #0e0e0e;
    color: #555555;
    border: 1px solid #1e1e1e;
    border-radius: 4px;
    font-size: 12px;
    padding: 0 10px;
}

#ComposerPushedBtn:hover {
    background: #1a1a1a;
    color: #999999;
    border-color: #2a2a2a;
}

#ComposerPushedBtn[on="true"] {
    background: #334466;
    color: #ffffff;
    border-color: #4477aa;
}

#ComposerPushedBtn:disabled {
    color: #2a2a2a;
    background: #0f0f0f;
    border-color: #1a1a1a;
}
