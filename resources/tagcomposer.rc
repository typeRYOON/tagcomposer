1 ICON "icons/icon.ico"
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ryoon"
            VALUE "FileDescription",  "TagComposer - prompt builder for ComfyUI"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "tagcomposer"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Ryan Magdaleno. Distributed under GPL v3."
            VALUE "OriginalFilename", "tagcomposer.exe"
            VALUE "ProductName",      "TagComposer"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
